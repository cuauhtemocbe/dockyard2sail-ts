#!/bin/sh

# Secret scanning runs on every commit (fast, unlike the full validation suite below).
# Fail closed: CI does not run gitleaks, so this hook is the only secret scan.
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --no-banner --redact
  if [ $? -ne 0 ]; then
    echo "❌ gitleaks found a potential secret in staged changes — commit blocked"
    exit 1
  fi
else
  echo "❌ gitleaks not installed — commit blocked (install: https://github.com/gitleaks/gitleaks#installing)" >&2
  exit 1
fi

# Lint/format staged files (fast — only touches what's staged, unlike the
# full validation suite which runs on merge/push instead)
pnpm exec lint-staged
if [ $? -ne 0 ]; then
  echo "❌ lint-staged found issues in staged files — commit blocked"
  exit 1
fi

echo "⚡ Skipping full validations on regular commit (validations run on merge only)"
exit 0
