#!/bin/sh

# Secret scanning runs on every commit (fast, unlike the full validation suite below).
# Fail closed: CI does not run gitleaks, so this hook is the only gitleaks scan.
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --no-banner --redact
  if [ $? -ne 0 ]; then
    echo "❌ gitleaks found a potential secret in staged changes — commit blocked"
    exit 1
  fi
else
  echo "❌ gitleaks not installed — commit blocked (install: https://github.com/gitleaks/gitleaks#installing)" >&2
  exit 1
fi

# Lint/format staged files + project-wide typecheck, inside the dev container
# via make (issue #86) — the host needs no Node tooling, like every other
# Docker-first target. Build is not run here: it runs in `make validate` and CI.
make lint-staged
if [ $? -ne 0 ]; then
  echo "❌ lint-staged failed (issues in staged files, or the container could not start) — commit blocked"
  echo "   First time, or empty dependency volume: run 'make lock-check'. Host port 5173 taken: set DEV_PORT."
  exit 1
fi

echo "⚡ Skipping full validations on regular commit (validations run on merge only)"
exit 0
